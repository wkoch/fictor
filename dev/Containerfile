FROM registry.fedoraproject.org/fedora-toolbox:44

# Keep development tools in the Toolbx image, never on the immutable host.
# Fedora 44 defaults to Node 22; select its Node 24 LTS binaries explicitly.
RUN dnf install --assumeyes \
        rust cargo clippy rustfmt gcc git \
        nodejs24-bin nodejs24-npm-bin uv bubblewrap ripgrep \
    && dnf clean all

# unshare makes mount propagation private before bubblewrap starts.
# Declare this dependency even when it is already present in the Toolbx base.
RUN dnf install --assumeyes util-linux && dnf clean all
