{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fictor.local/schemas/extension.schema.json",
  "title": "Fictor extension manifest (fictor.yaml)",
  "description": "Schema estrutural. Regras semânticas adicionais estão em spec/06-lifecycle.md, etapa 2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "description", "runtime"],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "name": { "type": "string", "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "role": { "enum": ["extension", "harness"], "default": "extension" },
    "hooks_api": { "type": "integer", "minimum": 1 },
    "scope": { "enum": ["global", "session"], "default": "global" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["deno", "node", "python", "binary", "remote", "none"] },
        "entry": { "$ref": "#/$defs/relPath" },
        "args": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "url": { "type": "string", "pattern": "^https://" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["deno", "node", "python", "binary"] } } },
          "then": { "required": ["entry"], "not": { "required": ["url"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "remote" } } },
          "then": { "required": ["url"], "not": { "required": ["entry"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "none" } } },
          "then": { "not": { "anyOf": [{ "required": ["entry"] }, { "required": ["url"] }] } }
        }
      ]
    },
    "mcp": { "type": "boolean" },
    "kernel": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "events.read", "events.write", "sessions", "sessions.input", "blobs", "kv",
          "tools", "hooks", "catalog", "ui", "timers", "ext.propose", "config", "approval"
        ]
      }
    },
    "hooks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point"],
        "properties": {
          "point": { "type": "string", "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+$", "maxLength": 64 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 100 },
          "timeout_ms": { "type": "integer", "minimum": 50, "maximum": 10000, "default": 2000 }
        }
      }
    },
    "tools": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
      "additionalProperties": { "$ref": "#/$defs/toolClass" }
    },
    "surfaces": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slot", "resource", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40 },
          "slot": { "enum": ["left", "right", "bottom"] },
          "resource": { "type": "string", "pattern": "^ui://" },
          "title": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "skills": { "$ref": "#/$defs/relPath" },
    "commands": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "prompt"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 40 },
          "description": { "type": "string", "maxLength": 200 },
          "prompt": { "$ref": "#/$defs/relPath" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "array", "items": { "$ref": "#/$defs/pathSpec" }, "uniqueItems": true },
            "write": { "type": "array", "items": { "$ref": "#/$defs/pathSpec" }, "uniqueItems": true }
          }
        },
        "net": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(\\*|(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:[0-9]{1,5})?|\\[[0-9A-Fa-f:.]+\\]:[0-9]{1,5})$"
              }
            }
          }
        },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(\\*|[a-z0-9][a-z0-9-]*)$" }
        },
        "spawn": { "type": "boolean", "default": false },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "env"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "env": { "$ref": "#/$defs/envName" }
            }
          }
        },
        "env": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/envName" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "isolation": { "enum": ["os", "container", "vm"], "default": "os" },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "evals": { "$ref": "#/$defs/relPath" }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "harness" } }, "required": ["role"] },
      "then": {
        "properties": { "scope": { "const": "session" } },
        "required": ["scope"],
        "not": { "required": ["hooks"] }
      }
    },
    {
      "if": { "required": ["hooks"] },
      "then": { "required": ["hooks_api"] }
    }
  ],
  "$defs": {
    "envName": {
      "description": "Nomes reservados: spec/04-extensions.md#variáveis-de-ambiente-reservadas.",
      "type": "string",
      "pattern": "^(?!(FICTOR_|LC_|LD_|DYLD_|DENO_|BASH_FUNC_))[A-Z][A-Z0-9_]*$",
      "not": {
        "enum": [
          "PATH", "HOME", "TMPDIR", "TMP", "TEMP", "LANG", "LANGUAGE", "USER", "LOGNAME", "SHELL", "PWD",
          "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "NODE_USE_ENV_PROXY",
          "SSL_CERT_FILE", "SSL_CERT_DIR", "NODE_EXTRA_CA_CERTS", "NODE_TLS_REJECT_UNAUTHORIZED",
          "REQUESTS_CA_BUNDLE", "CURL_CA_BUNDLE", "GIT_SSL_NO_VERIFY",
          "NODE_OPTIONS", "NODE_PATH", "PYTHONPATH", "PYTHONHOME", "PYTHONSTARTUP", "PYTHONUSERBASE",
          "BASH_ENV", "ENV", "PROMPT_COMMAND", "PERL5OPT", "RUBYOPT", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM",
          "SSH_AUTH_SOCK", "GPG_AGENT_INFO", "GNUPGHOME", "DOCKER_HOST", "XDG_RUNTIME_DIR",
          "DBUS_SESSION_BUS_ADDRESS", "DISPLAY", "WAYLAND_DISPLAY"
        ]
      }
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\\\u0000]+$"
    },
    "pathSpec": {
      "type": "string",
      "pattern": "^(\\$\\{(workspace|ext_data|ext_root|store|tmp)\\}(/[^\\u0000]*)?|/[^\\u0000]+|~/[^\\u0000]+)$"
    },
    "toolClass": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effect": { "enum": ["read", "write_local", "external"] },
        "sensitivity": { "enum": ["public", "private"] },
        "output_trust": { "enum": ["trusted", "untrusted", "workspace"] },
        "model_visible": { "type": "boolean", "default": true },
        "ui_callable": { "type": "boolean", "default": false },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 }
      }
    }
  }
}
